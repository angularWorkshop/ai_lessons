# Скопируй этот файл в .env и заполни один из вариантов.
# .env не попадает в git — ключ останется только у тебя.

# Вариант 1: ключ EduTec из профиля
LLM_BASE_URL=https://api.edutec.it.com/llm/v1
LLM_API_KEY=edk_...
LLM_MODEL=qwen/qwen3.7-flash

# Вариант 2: Ollama на своём компьютере (раскомментируй и закомментируй вариант 1)
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=qwen2.5:7b
