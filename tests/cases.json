[
  [
    "local commands specialize project defaults",
    {
      "project": {
        "test": "npm test"
      },
      "directory": {
        "test": "npm run test:unit"
      }
    },
    {
      "test": "npm run test:unit"
    }
  ],
  [
    "local instructions cannot relax secret policy",
    {
      "project": {
        "secretPolicy": "never-share"
      },
      "directory": {
        "secretPolicy": "share"
      }
    },
    {
      "secretPolicy": "never-share"
    }
  ],
  [
    "deployment boundary stays protected",
    {
      "project": {
        "deploymentPolicy": "human"
      },
      "directory": {
        "deploymentPolicy": "auto"
      }
    },
    {
      "deploymentPolicy": "human"
    }
  ],
  [
    "missing directory keeps root rules",
    {
      "project": {
        "test": "npm test"
      }
    },
    {
      "test": "npm test"
    }
  ]
]
